# Copy to .env.local and adjust.

# Secret used to sign session cookies. REQUIRED in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# SQLite database file (created automatically).
DATABASE_PATH=./data/squat-counter.db

# Only allow sign-ups from these email domains (comma separated). Empty = allow all.
ALLOWED_EMAIL_DOMAINS=

# Time zone used for "today / this week / this month" statistics.
APP_TIMEZONE=Asia/Ho_Chi_Minh
